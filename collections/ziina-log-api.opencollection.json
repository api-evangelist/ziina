{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ziina Account Log API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Log",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "LogController_processLog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-v2.ziina.com/api/log",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}